{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    // Runtime and `Env` types come from worker-configuration.d.ts, generated
    // by `pnpm types`. These add `cloudflare:test` for the integration tests,
    // and the rays Worker as the main module, which `wrangler types` can't
    // see because it's the virtual module `virtual:rays/worker`.
    "types": ["@cloudflare/vitest-plugin/types", "@rays/core/main"]
  },
  "include": ["worker-configuration.d.ts", "test/**/*.ts"]
}
