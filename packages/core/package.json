{
  "name": "@rays/core",
  "version": "0.1.0",
  "private": true,
  "description": "The rays build step and Worker runtime helpers: building Gleam projects into Worker entry modules, and using rays Workers from TypeScript.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
