{
  // Type checks the sources and tests together. Nothing is emitted. The tests
  // import the compiled `rays` Gleam package from the repository root's
  // `build/` directory.
  //
  // Editors pick up this file for everything under `src/` and `test/`:
  // language servers attach each file to the nearest `tsconfig.json`, so the
  // emitting build configs live in `tsconfig.runtime.json` and
  // `tsconfig.node.json` instead of this one.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "../..",
    "types": ["node", "@cloudflare/workers-types"],
    // Vitest's dependencies, Node's types and the Workers runtime types
    // conflict with each other.
    "skipLibCheck": true
  },
  "include": ["src", "test"],
  // Replaces the build config's `exclude`, which leaves out the tests.
  "exclude": []
}
