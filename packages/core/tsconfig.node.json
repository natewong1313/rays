{
  // The build step, `@rays/core/build`, which runs in Node.js or Bun on the
  // developer's machine. It uses only `node:` modules, so both can run it.
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // Tests sit next to the modules they test; the build leaves them out.
  "exclude": ["src/runtime.ts", "src/**/*.test.ts"]
}
