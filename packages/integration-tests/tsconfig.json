{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    // Runtime and `Env` types, and the main module for `exports`, come from
    // .cloudflare/types, which `pnpm types` (and `vite dev` and `vite build`)
    // generate from cloudflare.config.ts. These add `cloudflare:test` for
    // the tests.
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["cloudflare.config.ts", ".cloudflare/types", "test/**/*.ts"]
}
