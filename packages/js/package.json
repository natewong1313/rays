{
  "name": "@rays/cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "JavaScript helpers for using rays Workers alongside TypeScript Workers.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.node.json",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bin/rays",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "rays": "./dist/cli.js"
  }
}
