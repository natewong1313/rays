{
  // The Worker runtime helpers, `@rays/cloudflare/runtime`. They run inside
  // Workers, so they see the Workers runtime types and not Node's.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // `ExportedHandler` and the other runtime types. Users get the same
    // globals from `wrangler types` or `@cloudflare/workers-types`.
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/runtime.ts"]
}
