{
  // Type checks the tests, which import the compiled `rays` Gleam package
  // from the repository root's `build/` directory. Nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "../..",
    // Vitest's dependencies conflict with the Workers runtime types.
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
